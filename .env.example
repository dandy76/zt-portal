# Database
DB_PASS=change_me_db_password
DB_ROOT_PASS=change_me_root_password

# MikroTik REST API
MT_API_URL=https://10.0.40.1/rest
MT_API_USER=api_portal
MT_API_PASS=change_me_mikrotik_password

# App Secret (used for CSRF tokens, etc)
# Generate with: openssl rand -hex 32
APP_SECRET=change_me_random_secret_hex

# Authenticator app label — distinguishes deployments in the user's 2FA app.
# Example: "local-ztPortal" (dev) or "qubber-ztPortal" (client site)
TOTP_ISSUER=ZT-Portal
